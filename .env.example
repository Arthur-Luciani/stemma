# Configuração do Stemma. Copie para `.env` (na raiz do repo) e ajuste.
# Todas as variáveis são opcionais; o valor mostrado é o padrão.
# As marcadas com (Fx) só passam a ter efeito na fase indicada.

# --- Servidor ---------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8010
# LOG_LEVEL=INFO
# Origens extras liberadas em CORS (só para dev; em produção é mesma origem).
# CORS_ORIGINS=["http://localhost:5183"]
# (F5) Pasta do build do frontend servida pelo backend.
# SERVE_FRONTEND_DIR=../frontend/dist

# --- Dados ------------------------------------------------------------------
# Raiz de todos os dados (banco, áudios, stems, exports). Em produção: D:\stemma-data
# Caminho relativo é resolvido a partir da raiz do repo.
# STORAGE_ROOT=storage
# Banco (URL do SQLAlchemy). Vazio = sqlite:///<STORAGE_ROOT>/stemma.db
# DATABASE_URL=

# --- Pipeline ---------------------------------------------------------------
# Simula download/separação sem yt-dlp/Demucs. Útil para o frontend.
# Título com "[falha]" faz o job falso falhar na separação.
# STEMMA_FAKE_PIPELINE=0
# Duração total do job falso, em segundos.
# FAKE_PIPELINE_SECONDS=20
# Tentativas de um job interrompido (servidor caiu no meio) antes de falhar.
# JOB_MAX_ATTEMPTS=2
# Binário do FFmpeg (nome no PATH ou caminho absoluto).
# FFMPEG_BIN=ffmpeg

# --- yt-dlp -----------------------------------------------------------------
# Runtimes JS que o yt-dlp pode usar no YouTube, separados por vírgula, em ordem
# de preferência (o primeiro instalado é usado). O /health acusa se nenhum existir.
# YTDLP_JS_RUNTIME=deno,node
# Cookies do YouTube exportados do navegador (formato Netscape). Use quando o
# download falhar com "YouTube pediu login. Atualize os cookies."
# YTDLP_COOKIE_FILE=

# --- Demucs -----------------------------------------------------------------
# Modelo (htdemucs, htdemucs_ft — 4x mais lento —, mdx_extra…).
# SEPARATION_MODEL=htdemucs
# auto = tenta a GPU (cuda) e cai para a CPU se a GPU falhar; ou fixe cuda/cpu.
# DEMUCS_DEVICE=auto
# Tamanho do pedaço em segundos (menor = menos VRAM; o htdemucs aceita até 7).
# DEMUCS_SEGMENT=7
# DEMUCS_OVERLAP=0.25
# DEMUCS_SHIFTS=1
# Onde o Demucs guarda os modelos baixados. Vazio = <STORAGE_ROOT>/cache/torch
# TORCH_HOME=

# --- Timeouts dos subprocessos, em segundos -----------------------------------
# DOWNLOAD_TIMEOUT_S=600
# SEPARATION_TIMEOUT_S=1800
# FFMPEG_TIMEOUT_S=300
